[gd_scene load_steps=14 format=3]

[ext_resource type="Script" path="res://scripts/fireball.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/water_stream.gd" id="2_stream"]

[sub_resource type="SphereShape3D" id="shape"]
radius = 0.5

[sub_resource type="Shader" id="stream_shader"]
code = "shader_type spatial;
render_mode blend_mix, cull_disabled, depth_draw_never;

uniform vec4 base_color : source_color = vec4(0.70, 0.88, 0.98, 1.0);
uniform vec4 foam_color : source_color = vec4(0.96, 0.99, 1.0, 1.0);
uniform float wiggle = 0.45;
uniform float wave_speed = 5.0;
uniform float flow = 6.0;
uniform float phase = 0.0;

void vertex() {
	float u = UV.x;
	float t = TIME * wave_speed + phase;
	float amp = wiggle * smoothstep(0.0, 0.6, u);
	VERTEX.x += sin(u * 12.0 - t) * amp;
	VERTEX.y += cos(u * 9.0 - t * 1.3) * amp * 0.8;
}

void fragment() {
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.0);
	float streak = sin(UV.y * 6.28318 * 3.0 + UV.x * 14.0 - TIME * flow + phase);
	float foam = smoothstep(0.55, 0.95, streak);
	float fade = 1.0 - smoothstep(0.65, 1.0, UV.x);
	vec3 col = mix(base_color.rgb, foam_color.rgb, clamp(fres * 0.7 + foam * 0.8, 0.0, 1.0));
	ALBEDO = col;
	EMISSION = base_color.rgb * 0.25 + foam_color.rgb * foam * 0.3;
	ROUGHNESS = 0.1;
	SPECULAR = 0.8;
	ALPHA = clamp(0.38 + fres * 0.45 + foam * 0.3, 0.0, 0.95) * fade;
}"

[sub_resource type="ShaderMaterial" id="mat_a"]
shader = SubResource("stream_shader")
shader_parameter/wiggle = 0.45
shader_parameter/phase = 0.0

[sub_resource type="ShaderMaterial" id="mat_b"]
shader = SubResource("stream_shader")
shader_parameter/wiggle = 0.6
shader_parameter/phase = 3.14

[sub_resource type="Gradient" id="dot_grad"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="dot_tex"]
gradient = SubResource("dot_grad")
width = 64
height = 64
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[sub_resource type="StandardMaterial3D" id="soft_mat"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_texture = SubResource("dot_tex")
billboard_mode = 3
billboard_keep_scale = true

[sub_resource type="QuadMesh" id="drop_quad"]
